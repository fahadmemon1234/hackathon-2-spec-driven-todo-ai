# Node modules folder (generated by npm or yarn)
node_modules/

# Next.js build output (generated during the build process)
.next/

# Environment variable files (you may want to ignore files containing sensitive information)
.env.local
.env.development.local
.env.production.local

# Logs
*.log

# System files
.DS_Store        # macOS-specific
Thumbs.db        # Windows-specific

# IDE/Editor specific files
.vscode/          # Visual Studio Code settings
.idea/            # JetBrains IDE settings

# npm package lock file (if you're using yarn, this is not necessary)
package-lock.json

# Tailwind CSS build output (if you have a build folder for Tailwind)
public/css/
public/js/
